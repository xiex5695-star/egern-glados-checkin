#!name = GLaDOS 自动签到
#!desc = Loon版：自动获取登录凭据，每天00:05签到、15:15补签（设备时区），支持手动签到。首次需启用并信任Loon证书，然后登录并刷新GLaDOS签到页。Loon需运行才能执行定时任务。
#!author = xiex5695-star
#!homepage = https://github.com/xiex5695-star/egern-glados-checkin

# 使用兼容语法，适用于已有Loon版本及接受旧语法的新版本。
[Script]
http-request ^https:\/\/glados\.(cloud|rocks|network)\/(api\/|console(?:\/|\?|$)) script-path=https://raw.githubusercontent.com/xiex5695-star/egern-glados-checkin/main/glados-loon.js,tag=GLaDOS 获取登录凭据,requires-body=false,timeout=10,enable=true
cron "5 0 * * *" script-path=https://raw.githubusercontent.com/xiex5695-star/egern-glados-checkin/main/glados-loon.js,tag=GLaDOS 每日签到,timeout=60,enable=true
cron "15 15 * * *" script-path=https://raw.githubusercontent.com/xiex5695-star/egern-glados-checkin/main/glados-loon.js,tag=GLaDOS 下午补签,timeout=60,enable=true
generic script-path=https://raw.githubusercontent.com/xiex5695-star/egern-glados-checkin/main/glados-loon.js,tag=GLaDOS 手动签到,img-url=checkmark.seal.fill.system,timeout=60,enable=true

[Mitm]
hostname = glados.cloud,glados.rocks,glados.network
